# Copy to .env and fill in. Bun reads .env automatically. Do not commit .env.

# Public address of Gulpy
GULPY_BASE_URL=http://localhost:4000

# 32 bytes, base64. Make one with: openssl rand -base64 32
# In development on macOS you can leave this empty. Gulpy keeps a key in the Keychain.
GULPY_MASTER_KEY=

# SQLite file
GULPY_DB=.data/gulpy.db

# Google OAuth client. Redirect address: <GULPY_BASE_URL>/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth client. Redirect address: <GULPY_BASE_URL>/oauth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Provider ids for which /v1/proxy is on. The default is none. Keep Google and Microsoft out of this list.
GULPY_RAW_PROXY=

# off: the user approves each agent. The default is on: a known agent connects with no approval step.
GULPY_AUTO_APPROVE=

# Gulpy writes a copy of the database to this folder each day. Empty: no copies.
GULPY_BACKUP_DIR=

# Sends sign-in codes by email. Necessary in production.
RESEND_API_KEY=
MAIL_FROM=

# Paid plans through Stripe. Leave both empty to sell nothing: each person is then on Free.
# The webhook endpoint in Stripe: <GULPY_BASE_URL>/stripe/webhook, with the events
# checkout.session.completed and customer.subscription.created, .updated, .deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
